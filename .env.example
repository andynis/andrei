# Email Configuration
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FOLDER=INBOX

# AI Provider Configuration (choose one or multiple)
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude (alternative/fallback)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Default AI provider: openai or anthropic
AI_PROVIDER=anthropic

# WordPress Configuration
WORDPRESS_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=your-wp-username
WORDPRESS_APP_PASSWORD=your-wp-app-password
WORDPRESS_DEFAULT_CATEGORY=Press Releases
WORDPRESS_DEFAULT_TAGS=news,press

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# WhatsApp Configuration (via Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1234567890

# Email Notifications
NOTIFICATION_EMAIL_FROM=notifications@example.com
NOTIFICATION_EMAIL_TO=editorial-team@example.com
NOTIFICATION_SMTP_HOST=smtp.gmail.com
NOTIFICATION_SMTP_PORT=587

# Processing Configuration
CHECK_INTERVAL_MINUTES=15
MAX_RETRIES=3
TEMP_FILES_DIR=./temp
PROCESSED_EMAILS_LOG=./processed_emails.json
